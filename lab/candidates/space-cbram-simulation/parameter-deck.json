{
  "deck_version": "1.0.0",
  "candidate_id": "space-cbram-si-translation",
  "regime": "space",
  "purpose": "Translate an accepted CBRAM screening draw into SI geometry, conductance observables, environmental schedules, radiation tally targets, and explicit mission and constitutive blockers for later MOOSE/OpenMC coupling.",
  "source_manifest": "lab/candidates/material-manifests/space-cbram.json",
  "source_calibration": "lab/materials-calibration.md",
  "observable_rule": "Reversible terminal conductance is primary. Bulk silver conductivity is reference-only and cannot be assigned to a filament until filament length and cross-sectional area are measured.",
  "input_map": {
    "numeric_parameters.geometry.cell_width": { "solver_targets": ["moose-conduction", "moose-thermal", "moose-mechanics", "openmc-geometry"], "admission": "ready" },
    "numeric_parameters.geometry.cell_height": { "solver_targets": ["moose-conduction", "moose-thermal", "moose-mechanics", "openmc-geometry"], "admission": "ready" },
    "numeric_parameters.geometry.silver_electrode_thickness": { "solver_targets": ["moose-conduction", "moose-thermal", "moose-mechanics", "openmc-geometry"], "admission": "ready" },
    "numeric_parameters.geometry.solid_electrolyte_thickness": { "solver_targets": ["moose-conduction", "moose-thermal", "moose-mechanics", "openmc-geometry"], "admission": "ready" },
    "numeric_parameters.geometry.inert_electrode_thickness": { "solver_targets": ["moose-conduction", "moose-thermal", "moose-mechanics", "openmc-geometry"], "admission": "ready" },
    "numeric_parameters.geometry.passivation_thickness": { "solver_targets": ["moose-thermal", "moose-mechanics", "openmc-geometry"], "admission": "ready" },
    "numeric_parameters.geometry.array_rows": { "solver_targets": ["mesh-layout", "experiment-control"], "admission": "ready" },
    "numeric_parameters.geometry.array_columns": { "solver_targets": ["mesh-layout", "experiment-control"], "admission": "ready" },

    "numeric_parameters.reservoir.bulk_silver_density": { "solver_targets": ["moose-thermal", "moose-mechanics", "openmc-material"], "admission": "conditional", "reason": "Bulk reference is usable for an inventory check; the deposited thin-film density still requires metrology before predictive coupling." },
    "numeric_parameters.reservoir.silver_reservoir_mass_per_cell": { "solver_targets": ["global-mass-constraint"], "admission": "ready" },
    "numeric_parameters.reservoir.bulk_silver_conductivity_reference": { "solver_targets": ["reference-only"], "admission": "reference-only", "reason": "Filament conductivity remains undefined until filament geometry and state are measured." },

    "numeric_parameters.electrical_drive.read_voltage": { "solver_targets": ["moose-conduction"], "admission": "ready" },
    "numeric_parameters.electrical_drive.set_sweep_limit": { "solver_targets": ["moose-conduction", "experiment-control"], "admission": "ready" },
    "numeric_parameters.electrical_drive.reset_sweep_limit": { "solver_targets": ["moose-conduction", "experiment-control"], "admission": "ready" },
    "numeric_parameters.electrical_drive.absolute_voltage_ceiling": { "solver_targets": ["moose-conduction", "experiment-control"], "admission": "ready" },
    "numeric_parameters.electrical_drive.compliance_low": { "solver_targets": ["moose-conduction", "external-circuit-limit"], "admission": "ready" },
    "numeric_parameters.electrical_drive.compliance_mid": { "solver_targets": ["moose-conduction", "external-circuit-limit"], "admission": "ready" },
    "numeric_parameters.electrical_drive.compliance_high": { "solver_targets": ["moose-conduction", "external-circuit-limit"], "admission": "ready" },

    "numeric_parameters.electrical_admission.nominal_on_conductance": { "solver_targets": ["moose-conduction", "observable", "postprocessor"], "admission": "observable-only", "reason": "Use terminal conductance or resistance; do not infer filament conductivity." },
    "numeric_parameters.electrical_admission.minimum_on_off_ratio": { "solver_targets": ["postprocessor"], "admission": "ready" },
    "numeric_parameters.electrical_admission.unbiased_retention_hold": { "solver_targets": ["experiment-control", "postprocessor"], "admission": "ready" },

    "numeric_parameters.vacuum_environment.vacuum_pressure_maximum": { "solver_targets": ["environment-metadata"], "admission": "metadata-only", "reason": "Pressure requires gas composition and outgassing constitutive laws before it can drive a MOOSE field." },
    "numeric_parameters.vacuum_environment.comparison_temperature": { "solver_targets": ["moose-thermal", "openmc-material-temperature"], "admission": "ready" },
    "numeric_parameters.vacuum_environment.screen_temperature_minimum": { "solver_targets": ["moose-thermal"], "admission": "screening-only", "reason": "Generic material screen, not mission qualification." },
    "numeric_parameters.vacuum_environment.screen_temperature_maximum": { "solver_targets": ["moose-thermal"], "admission": "screening-only", "reason": "Generic material screen, not mission qualification." },
    "numeric_parameters.vacuum_environment.thermal_cycle_count": { "solver_targets": ["moose-thermal", "moose-mechanics", "experiment-control"], "admission": "screening-only" },
    "numeric_parameters.vacuum_environment.temperature_ramp_rate_maximum": { "solver_targets": ["moose-thermal", "moose-mechanics"], "admission": "screening-only" },
    "numeric_parameters.vacuum_environment.plateau_dwell": { "solver_targets": ["moose-thermal", "experiment-control"], "admission": "screening-only" },

    "numeric_parameters.vacuum_falsifier.air_cell_count": { "solver_targets": ["experiment-design"], "admission": "metadata-only" },
    "numeric_parameters.vacuum_falsifier.vacuum_cell_count": { "solver_targets": ["experiment-design"], "admission": "metadata-only" },
    "numeric_parameters.vacuum_falsifier.set_reset_cycles_per_cell": { "solver_targets": ["experiment-design", "postprocessor"], "admission": "metadata-only" },
    "numeric_parameters.vacuum_falsifier.maximum_vacuum_cell_failures": { "solver_targets": ["postprocessor"], "admission": "ready" },
    "numeric_parameters.vacuum_falsifier.maximum_median_fractional_drift": { "solver_targets": ["postprocessor"], "admission": "ready" },
    "numeric_parameters.vacuum_falsifier.maximum_spontaneous_switch_rate": { "solver_targets": ["postprocessor"], "admission": "ready" },

    "numeric_parameters.optical_interface.fabrication_photodoping_wavelength": { "solver_targets": ["fabrication-metadata"], "admission": "metadata-only", "reason": "No photodoping dose or Ag-profile constitutive law is calibrated." },
    "numeric_parameters.optical_interface.operational_address_wavelength": { "solver_targets": ["external-controller-metadata"], "admission": "metadata-only", "reason": "The admitted mechanism is optical-to-electrical addressing, not direct filament illumination." },

    "numeric_parameters.radiation_materials_screen.cobalt60_dose_step_1": { "solver_targets": ["openmc-tally-target"], "admission": "screening-only", "reason": "Absorbed dose target in silicon, not a particle source specification." },
    "numeric_parameters.radiation_materials_screen.cobalt60_dose_step_2": { "solver_targets": ["openmc-tally-target"], "admission": "screening-only", "reason": "Absorbed dose target in silicon, not a particle source specification." },
    "numeric_parameters.radiation_materials_screen.cobalt60_dose_step_3": { "solver_targets": ["openmc-tally-target"], "admission": "screening-only", "reason": "Absorbed dose target in silicon, not a particle source specification." },
    "numeric_parameters.radiation_materials_screen.cobalt60_dose_step_4": { "solver_targets": ["openmc-tally-target"], "admission": "screening-only", "reason": "Absorbed dose target in silicon, not a particle source specification." },
    "numeric_parameters.radiation_materials_screen.maximum_programming_efficacy_fractional_drift": { "solver_targets": ["coupling-postprocessor"], "admission": "screening-only" }
  },
  "mission_gate_map": {
    "required_unset_gates.mission_total_ionizing_dose": { "solver_targets": ["openmc-normalization", "coupling-promotion"] },
    "required_unset_gates.mission_single_event_let_threshold": { "solver_targets": ["openmc-see-response", "coupling-promotion"] },
    "required_unset_gates.mission_heavy_ion_fluence": { "solver_targets": ["openmc-source-normalization", "coupling-promotion"] },
    "required_unset_gates.mission_displacement_damage_fluence": { "solver_targets": ["openmc-damage-response", "coupling-promotion"] },
    "required_unset_gates.mission_lifetime": { "solver_targets": ["moose-transient", "openmc-normalization", "coupling-promotion"] },
    "required_unset_gates.mission_shielding_areal_density": { "solver_targets": ["openmc-geometry", "openmc-material", "coupling-promotion"] },
    "required_unset_gates.mission_operational_temperature_minimum": { "solver_targets": ["moose-thermal", "moose-mechanics", "openmc-material-temperature", "coupling-promotion"] },
    "required_unset_gates.mission_operational_temperature_maximum": { "solver_targets": ["moose-thermal", "moose-mechanics", "openmc-material-temperature", "coupling-promotion"] }
  },
  "reference_quantities": {
    "avogadro_constant": {
      "value": 6.02214076e23,
      "unit": "mol^-1",
      "status": "established-exact-si",
      "range": { "minimum": 6.02214076e23, "maximum": 6.02214076e23 },
      "source": "https://physics.nist.gov/cgi-bin/cuu/Value?na"
    },
    "elementary_charge": {
      "value": 1.602176634e-19,
      "unit": "C",
      "status": "established-exact-si",
      "range": { "minimum": 1.602176634e-19, "maximum": 1.602176634e-19 },
      "source": "https://physics.nist.gov/cgi-bin/cuu/Value?e"
    },
    "boltzmann_constant": {
      "value": 1.380649e-23,
      "unit": "J K^-1",
      "status": "established-exact-si",
      "range": { "minimum": 1.380649e-23, "maximum": 1.380649e-23 },
      "source": "https://physics.nist.gov/cgi-bin/cuu/Value?k"
    },
    "planck_constant": {
      "value": 6.62607015e-34,
      "unit": "J s",
      "status": "established-exact-si",
      "range": { "minimum": 6.62607015e-34, "maximum": 6.62607015e-34 },
      "source": "https://physics.nist.gov/cgi-bin/cuu/Value?h"
    },
