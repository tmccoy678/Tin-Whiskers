  "dimensionless_groups": {
    "cell_lateral_aspect": "L_width / L_height",
    "electrolyte_to_lateral_scale": "t_electrolyte / sqrt(L_width L_height)",
    "silver_to_electrolyte_thickness": "t_Ag / t_electrolyte",
    "passivation_to_electrolyte_thickness": "t_cap / t_electrolyte",
    "read_to_set_voltage": "V_read / V_set_limit",
    "set_voltage_to_thermal_potential": "e V_set_limit / (k_B T)",
    "reservoir_mass_consistency": "rho_Ag L_width L_height t_Ag / m_Ag_manifest",
    "nominal_read_current_to_high_compliance": "V_read G_on / I_compliance_high",
    "temperature_screen_span_fraction": "(T_hot - T_cold) / T_compare",
    "vacuum_to_standard_atmosphere": "p_vacuum_max / p_standard",
    "radiation_screen_dose_span": "D_screen_max / D_screen_min",
    "programming_drift_tolerance": "delta_G_program_max / G_program_reference"
  },
  "constitutive_blockers": [
    {
      "blocker_id": "filament-geometry",
      "solver_targets": ["moose-conduction", "moose-thermal", "moose-mechanics"],
      "missing": ["filament length", "filament cross-sectional area", "filament tortuosity", "filament continuity and contact shape"],
      "reason": "Terminal conductance cannot be converted to filament conductivity or current density without measured geometry."
    },
    {
      "blocker_id": "solid-electrolyte-ion-transport",
      "solver_targets": ["moose-conduction"],
      "missing": ["Ag+ diffusivity in photodoped Ge30Se70", "Ag+ mobility", "mobile-ion concentration", "transference number", "temperature dependence", "electric permittivity"],
      "reason": "Terminal voltage does not determine Ag-ion flux or local field."
    },
    {
      "blocker_id": "interface-redox-kinetics",
      "solver_targets": ["moose-conduction"],
      "missing": ["Ag oxidation exchange current", "Ag+ reduction exchange current", "transfer coefficients", "equilibrium potentials", "nucleation barrier", "dissolution law"],
      "reason": "SET and RESET limits are experimental boundaries, not a reversible filament-growth rate law."
    },
    {
      "blocker_id": "electronic-state-conduction",
      "solver_targets": ["moose-conduction"],
      "missing": ["HRS conduction law", "LRS conduction law", "contact resistance", "tunneling gap relation", "temperature dependence", "state-to-state variability"],
      "reason": "Conductance remains the observable; bulk Ag conductivity cannot replace these laws."
    },
    {
      "blocker_id": "pulse-time-history",
      "solver_targets": ["moose-conduction", "moose-thermal"],
      "missing": ["SET pulse duration", "RESET pulse duration", "voltage ramp rate", "inter-pulse dwell", "read cadence"],
      "reason": "Voltage and compliance alone cannot determine electrical energy, switching kinetics, or Joule dose."
    },
    {
      "blocker_id": "layer-thermal-properties",
      "solver_targets": ["moose-thermal", "openmc-temperature-feedback"],
      "missing": ["density of Ge30Se70, inert electrode, cap, and substrate", "specific heat of every layer", "thermal conductivity of every layer", "interface thermal resistance", "emissivity", "package thermal boundary"],
      "reason": "The thermal schedule is known, but self-heating and layer temperatures are not predictable."
    },
    {
      "blocker_id": "layer-mechanical-properties",
      "solver_targets": ["moose-mechanics"],
      "missing": ["elastic moduli", "Poisson ratios", "coefficients of thermal expansion", "residual film stress", "adhesion and fracture energies", "creep or viscoelastic laws"],
      "reason": "Geometry and temperature cycles do not determine stress, delamination, or cracking."
    },
    {
      "blocker_id": "passivation-vacuum-law",
      "solver_targets": ["moose-thermal", "moose-mechanics", "environment-model"],
      "missing": ["cap permeability", "outgassing rates", "trapped gas composition", "vacuum interface heat transfer", "tarnish kinetics at defects"],
      "reason": "Chamber pressure is metadata until cap and gas transport are calibrated."
    },
    {
      "blocker_id": "optical-to-electrical-transfer",
      "solver_targets": ["external-controller", "moose-conduction"],
      "missing": ["photodiode responsivity", "micro-LED efficiency", "optical coupling loss", "driver transfer function", "photodoping dose-to-Ag-profile law"],
      "reason": "Wavelength identifies the interface but does not determine an electrical SET pulse or Ag distribution."
    },
    {
      "blocker_id": "openmc-material-definitions",
      "solver_targets": ["openmc-material", "openmc-heating"],
      "missing": ["measured Ge-Se-Ag atomic composition", "isotopic composition", "density of every non-Ag layer", "selected inert-electrode material", "selected cap material", "substrate and package composition"],
      "reason": "OpenMC reaction rates and heating tallies require material atom densities; geometry alone is insufficient."
    },
    {
      "blocker_id": "mission-radiation-source",
      "solver_targets": ["openmc-source", "openmc-normalization"],
      "missing": ["orbit or trajectory", "particle species", "energy spectra", "angular distributions", "time history", "device-local shielding geometry", "source rate"],
      "reason": "The cobalt-60 dose points are screening targets, not a mission radiation source."
    },
    {
      "blocker_id": "dose-material-conversion",
      "solver_targets": ["openmc-heating", "moose-thermal", "coupling-transfer"],
      "missing": ["silicon-equivalent scoring volume", "device-material heating tallies", "mass normalization", "dose-to-temperature transfer", "dose-to-conductance response"],
      "reason": "Gy(Si) cannot be assigned as absorbed energy in Ag, Ge-Se, cap, or substrate without transport and mass-specific tallies."
    },
    {
      "blocker_id": "displacement-and-see-response",
      "solver_targets": ["openmc-damage-response", "openmc-see-response", "coupling-postprocessor"],
      "missing": ["damage-energy cross sections", "NIEL or DPA response", "sensitive volume", "critical charge or conductance upset rule", "device and peripheral SEE cross sections"],
      "reason": "TID behavior does not supply displacement-damage or single-event constitutive response."
    },
    {
      "blocker_id": "radiation-programming-coupling",
      "solver_targets": ["moose-conduction", "openmc-heating", "coupling-transfer"],
      "missing": ["dose-dependent ion mobility", "dose-dependent interface kinetics", "dose-dependent conductance-update law", "annealing and recovery law"],
      "reason": "Published programming degradation motivates measurement but does not furnish an exact-stack coupling coefficient."
    },
    {
      "blocker_id": "stochastic-filament-population",
      "solver_targets": ["moose-conduction", "coupling-ensemble"],
      "missing": ["nucleation distribution", "cycle-to-cycle variance", "cell-to-cell covariance", "failure-hazard law", "radiation-conditioned variability"],
      "reason": "A random simulation seed is not a physical filament population until exact-stack ensembles are measured."
    }
  ],
  "sources": [
