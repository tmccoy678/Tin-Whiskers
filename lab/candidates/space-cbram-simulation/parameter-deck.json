      "value": 0.1078682,
      "unit": "kg mol^-1",
      "status": "established-reference",
      "range": { "minimum": 0.1078682, "maximum": 0.1078682 },
      "source": "https://nvlpubs.nist.gov/nistpubs/Legacy/TN/nbstechnicalnote1363.pdf"
    },
    "standard_atmosphere": {
      "value": 101325.0,
      "unit": "Pa",
