    { "source_id": "nist-silver", "url": "https://nvlpubs.nist.gov/nistpubs/Legacy/TN/nbstechnicalnote1363.pdf", "scope": "Bulk silver density and molar-mass reference." },
    { "source_id": "iaea-conductors", "url": "https://www-pub.iaea.org/MTCD/Publications/PDF/TCS-48_web.pdf", "scope": "Bulk silver conductivity reference only." },
    { "source_id": "openmc-tallies", "url": "https://docs.openmc.org/en/stable/usersguide/tallies.html", "scope": "Heating tally normalization and absorbed dose in silicon require material density, volume, and source normalization." },
    { "source_id": "openmc-energy-deposition", "url": "https://docs.openmc.org/en/stable/methods/energy_deposition.html", "scope": "OpenMC heating and energy-deposition method boundary." },
    { "source_id": "moose-heat-transfer", "url": "https://mooseframework.inl.gov/modules/heat_transfer/index.html", "scope": "MOOSE heat-conduction equations require density, heat capacity, conductivity, sources, and boundary conditions." },
    { "source_id": "cardinal-coupling", "url": "https://mooseframework.inl.gov/cardinal/tutorials/lwr_solid", "scope": "Official example of transferring OpenMC heat sources to MOOSE and temperature feedback to OpenMC." }
  ]
